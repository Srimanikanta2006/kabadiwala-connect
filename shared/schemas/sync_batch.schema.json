{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OfflineSyncBatchRequest",
  "type": "object",
  "required": ["client_id", "batch_id", "timestamp", "lots", "handover_records"],
  "properties": {
    "client_id": { "type": "string" },
    "batch_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "lots": {
      "type": "array",
      "items": { "$ref": "lot.schema.json" }
    },
    "handover_records": {
      "type": "array",
      "items": { "$ref": "traceability.schema.json" }
    },
    "user_feedback_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["image_phash", "ai_predicted_id", "user_corrected_id"],
        "properties": {
          "image_phash": { "type": "string" },
          "ai_predicted_id": { "type": "string" },
          "user_corrected_id": { "type": "string" },
          "client_timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}

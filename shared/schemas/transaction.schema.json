{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransactionLedgerRecord",
  "type": "object",
  "required": [
    "transaction_id",
    "lot_id",
    "collector_id",
    "recycler_id",
    "final_settled_amount_inr",
    "payment_mode",
    "payment_status",
    "settled_at"
  ],
  "properties": {
    "transaction_id": { "type": "string", "format": "uuid" },
    "lot_id": { "type": "string", "format": "uuid" },
    "collector_id": { "type": "string" },
    "recycler_id": { "type": "string", "format": "uuid" },
    "quoted_estimate_inr": { "type": "number", "minimum": 0 },
    "final_settled_amount_inr": { "type": "number", "minimum": 0 },
    "payment_mode": { 
      "type": "string", 
      "enum": ["CASH", "UPI", "DIRECT_BANK_TRANSFER"] 
    },
    "payment_status": { 
      "type": "string", 
      "enum": ["PENDING_SETTLEMENT", "PAID_CASH_CONFIRMED", "PAID_UPI_SUCCESS", "FAILED"] 
    },
    "upi_transaction_ref": { "type": "string" },
    "settled_at": { "type": "string", "format": "date-time" },
    "collector_receipt_number": { "type": "string" }
  }
}
